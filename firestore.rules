rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función: ¿el usuario tiene el rol 'admin'?
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función: ¿el usuario tiene el rol 'judge'?
    function isJudge() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge';
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read: if request.auth != null;
      // Admin puede escribir cualquier perfil
      allow write: if isAdmin();
      // Un usuario puede crear su propio perfil si no existe aún (primer acceso)
      allow create: if request.auth.uid == userId
                    && !exists(/databases/$(database)/documents/users/$(userId));
    }

    // Equipos
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Puntajes
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow write: if isJudge() || isAdmin();
    }

    // Instituciones
    match /institutions/{instId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Configuración de competencia (round locks, etc.)
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
