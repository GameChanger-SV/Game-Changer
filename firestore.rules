rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función: ¿el usuario tiene el rol 'admin'?
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Función: ¿el usuario tiene el rol 'judge'?
    function isJudge() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge';
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      // El usuario puede leer su propio perfil
      allow read: if request.auth.uid == userId;
    }

    // Equipos
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Puntajes
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      // El juez solo puede escribir puntajes de sus equipos asignados
      allow write: if isJudge() || isAdmin();
    }
  }
}
